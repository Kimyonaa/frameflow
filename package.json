{
  "name": "frameflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"node --watch server/index.js\" \"vite --host 127.0.0.1\"",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "node --test server/*.test.js",
    "test:e2e": "playwright test",
    "format": "prettier --write src server tests *.js *.json *.md",
    "check:format": "prettier --check src server tests *.js *.json *.md",
    "db:up": "docker compose up -d mongo",
    "db:down": "docker compose stop mongo"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.4",
    "express": "^5.0.0",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "lucide-react": "^0.468.0",
    "mongoose": "^8.0.0",
    "multer": "^2.4.0",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.4",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "concurrently": "^9.0.0",
    "prettier": "^3.9.9",
    "supertest": "^7.3.0",
    "vite": "^6.0.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
